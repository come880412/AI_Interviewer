# claude_code = use your Claude Code login, no API key needed (slower first token, ~2-3s)
# api         = Anthropic API, needs ANTHROPIC_API_KEY below
LLM_BACKEND=claude_code
# Only for LLM_BACKEND=claude_code if the CLI is not on PATH or in the VS Code extension folder
# CLAUDE_CODE_PATH=
ANTHROPIC_API_KEY=sk-ant-...

# Interviewer brain
LLM_MODEL=claude-opus-5-5
# off = fastest replies; adaptive = Claude thinks before replying (sharper follow-ups, slower)
INTERVIEWER_THINKING=off
# Model for the post-interview report (no latency pressure)
FEEDBACK_MODEL=claude-opus-5-5
AUTO_FEEDBACK=true

# Speech-to-text (local faster-whisper)
WHISPER_MODEL=large-v3
# Drop Whisper segments below this confidence as hallucinations (lower it if real words go missing)
WHISPER_MIN_AVG_LOGPROB=-1.0
# whisper (takes hotwords as a prompt) or parakeet (NVIDIA Parakeet TDT v3: faster, re-transcribes each whole answer)
STT_BACKEND=whisper
# Save each answer's audio next to the transcript so compare_stt.py can compare models on your own voice
SAVE_CANDIDATE_AUDIO=false
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Text-to-speech (local Kokoro): run on the GPU
ONNX_PROVIDER=CUDAExecutionProvider

# Seconds of silence before the interviewer checks whether you are done (raise if it cuts you off)
CANDIDATE_PAUSE_SECS=0.8

# Interviewer volume boost in dB (raise if too quiet; lower if it sounds distorted)
VOICE_GAIN_DB=10

# Default interview folder under interviews/ (otherwise: --interview NAME, or pick from a list at startup)
# INTERVIEW=example/tech
